<?xml version="1.0" encoding="utf-8"?>
<extension key="m365groupsync" type="module">
  <file>m365groupsync</file>
  <name>Microsoft 365 Group Sync</name>
  <description>One-way reconciliation of CiviCRM Groups with Microsoft 365 Group membership.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Jose Torres</author>
    <email>jtorres@pesc.com</email>
  </maintainer>
  <version>1.4.0</version><releaseDate>2026-08-25</releaseDate>
  <compatibility><ver>6.17</ver></compatibility>
  <php_compatibility><ver>8.1</ver><ver>8.2</ver><ver>8.3</ver><ver>8.4</ver></php_compatibility>
  <classloader><psr0 prefix="CRM_" path="."/><psr4 prefix="Civi\" path="Civi"/></classloader>
  <mixins><mixin>scan-classes@1.0.0</mixin><mixin>mgd-php@2.0.0</mixin><mixin>smarty@1.0.3</mixin><mixin>menu-xml@1.0.0</mixin><mixin>entity-types-php@2.0.0</mixin></mixins>
  <upgrader>CRM_M365GroupSync_Upgrader</upgrader>
</extension>
